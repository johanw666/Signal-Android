    <string name="PasskeysScreen__learn_more">Докладніше</string>
    <!-- Bullet point explaining that a passkey can be given a name -->
    <string name="PasskeysScreen__give_your_passkey_a_friendly_name">Дайте назву своєму ключу доступу, щоб не плутати його з іншими</string>
