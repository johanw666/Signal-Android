    <!-- AccountSettingsFragment -->
    <string name="AccountSettingsFragment__account">Сметка</string>
    <string name="AccountSettingsFragment__youll_be_asked_less_frequently">Со тек на време ќе Ве потсетуваме се поретко.</string>
    <string name="AccountSettingsFragment__require_your_signal_pin">Барај го Signal PIN-от за повторна регистрација на Вашиот телефонски број на Signal</string>
    <string name="AccountSettingsFragment__change_phone_number">Промени телефонски број</string>
    <!-- Account setting that allows user to request and export their signal account data -->
    <string name="AccountSettingsFragment__request_account_data">Податоци за вашата сметка</string>
    <!-- Section header for the Signal Login section of account settings -->
    <string name="AccountSettingsFragment__signal_login">Signal-најава</string>
    <!-- Title of the card that opens the user\'s Signal Login account and recovery keys -->
    <string name="AccountSettingsFragment__account_and_recovery">Корисничка сметка и добивање повторен пристап до неа</string>
    <!-- Description of what a Signal Login is, shown below the Signal Login card -->
    <string name="AccountSettingsFragment__your_signal_login_is_used_to_recover">Вашата Signal-најава се користи за добивање повторен пристап и враќање на вашата корисничка сметка. Овие клучеви чувајте ги безбедно во управувач со лозинки во кој имате доверба.</string>
    <!-- Section header for the two-factor authentication section of account settings -->
    <string name="AccountSettingsFragment__two_factor_authentication">Двофакторска автентикација</string>
    <!-- Account setting that takes the user to the authenticator app setup flow -->
    <string name="AccountSettingsFragment__authenticator_app">Апликација за автентикација</string>
    <!-- Description of the authenticator app setting when none are configured -->
    <string name="AccountSettingsFragment__one_time_verification_codes">Еднократни кодови за верификација</string>
    <!-- Description of the authenticator app setting saying how many are configured -->
    <plurals name="AccountSettingsFragment__d_configured">
        <item quantity="one">%1$d поставена</item>
        <item quantity="other">%1$d поставени</item>
    </plurals>
    <!-- Account setting that takes the user to the passkeys screen -->
    <string name="AccountSettingsFragment__passkeys">Клучеви за пристап</string>
    <!-- Description of the passkeys setting when none exist -->
    <string name="AccountSettingsFragment__device_biometrics_or_fido2_security_key">Биометриски податоци на вашиот уред или безбедносен клуч по FIDO2 стандард</string>
    <!-- Description of the passkeys setting saying how many exist -->
    <plurals name="AccountSettingsFragment__d_passkeys">
        <item quantity="one">%1$d клуч за пристап</item>
        <item quantity="other">%1$d клучеви за пристап</item>
    </plurals>
    <!-- Description of two-factor authentication, shown below the two-factor authentication rows -->
    <string name="AccountSettingsFragment__use_a_second_form_of_authentication">Користете втора форма на автентикација за да ја заштите вашата корисничка сметка кога користите Signal-најава на нов уред.</string>
    <!-- Clickable text that takes the user to a support article -->
    <string name="AccountSettingsFragment__learn_more">Дознајте повеќе</string>

    <!-- TotpSetupScreen -->
    <!-- Title of the screen that walks the user through setting up an authenticator app -->
    <string name="TotpSetupScreen__set_up_your_authenticator_app">Поставeте ја вашата апликација за автентикација</string>
    <!-- Instructions shown at the top of the authenticator app setup screen -->
    <string name="TotpSetupScreen__follow_these_steps">Следете ги овие чекори за да ја поставите вашата апликација за автентикација.</string>
    <!-- Clickable text that takes the user to a support article -->
    <string name="TotpSetupScreen__learn_more">Дознајте повеќе</string>
    <!-- Header of the first step of authenticator app setup -->
    <string name="TotpSetupScreen__step_1">Прв чекор</string>
    <!-- Body of the first step of authenticator app setup -->
    <string name="TotpSetupScreen__install_a_trusted_authenticator_app">На вашиот уред инсталирајте апликација за автентикација од доверлив извор.</string>
    <!-- Header of the second step of authenticator app setup -->
    <string name="TotpSetupScreen__step_2">Втор чекор</string>
    <!-- Body of the second step of authenticator app setup -->
    <string name="TotpSetupScreen__open_your_authenticator_app">Отворете ја апликацијата за автентикација со допирање на копчето подолу за да ја додадете вашата корисничка сметка на Signal.</string>
    <!-- Button that opens the user\'s authenticator app -->
    <string name="TotpSetupScreen__open">Отворете</string>
    <!-- Text above the setup key explaining that it can be entered by hand instead -->
    <string name="TotpSetupScreen__or_you_can_copy_this_key">Или можете да го ископирате овој клуч за да ја поставите рачно.</string>
    <!-- Button that copies the setup key to the clipboard -->
    <string name="TotpSetupScreen__copy">Копирај</string>
    <!-- Toast shown after the setup key has been copied to the clipboard -->
    <string name="TotpSetupScreen__copied_to_clipboard">Копирано на таблата со исечоци</string>
    <!-- Toast shown when there is no app installed that can handle the authenticator setup link -->
    <string name="TotpSetupScreen__no_authenticator_app_found">Не е пронајдена апликација за автентикација</string>
    <!-- Dialog message shown when we couldn\'t reach the service to start setting up an authenticator app -->
    <string name="TotpSetupScreen__couldnt_reach_signal">Couldn\'t reach Signal. Check your connection and try again.</string>
    <!-- Header of the third step of authenticator app setup -->
    <string name="TotpSetupScreen__step_3">Трет чекор</string>
    <!-- Body of the third step of authenticator app setup -->
    <string name="TotpSetupScreen__copy_the_code_thats_generated">Ископирајте го кодот којшто е генериран и вратете се овде за да продолжите.</string>
    <!-- Button that advances from the setup instructions to entering a code -->
    <string name="TotpSetupScreen__continue">Продолжи</string>

    <!-- PasskeysScreen -->
    <!-- Title of the screen where the user sets up passkeys -->
    <string name="PasskeysScreen__passkeys">Клучеви за пристап</string>
    <!-- Description of passkeys shown at the top of the screen -->
    <string name="PasskeysScreen__with_passkeys_you_can_easily_add">Со клучевите за пристап, лесно можете да додадете безбедна секундарна форма на автентикација на вашата корисничка сметка. Клучевите за пристап можат да ги користат биометриските податоци на вашиот уред или компатибилен безбедносен клуч по FIDO2 стандард.</string>
    <!-- Clickable text that takes the user to a support article -->
    <string name="PasskeysScreen__learn_more">Дознајте повеќе</string>
    <!-- Bullet point explaining that a passkey can be given a name -->
    <string name="PasskeysScreen__give_your_passkey_a_friendly_name">Именувајте го вашиот клуч за пристап со препознатливо име за да го идентификувате</string>
    <!-- Bullet point explaining how a passkey is stored -->
    <string name="PasskeysScreen__use_your_devices_biometrics">Употребете ги биометриските податоци на вашиот уред или безбедносен клуч по FIDO2 стандард за да го зачувате вашиот клуч за пристап</string>
    <!-- Bullet point explaining that passkeys can be added and removed -->
    <string name="PasskeysScreen__add_or_remove_passkeys_at_anytime">Во кое било време додајте или отстранете клуч за пристап.</string>
    <!-- Button that starts creating a passkey -->
    <string name="PasskeysScreen__set_up_a_passkey">Поставeте клуч за пристап</string>
    <!-- Description of passkeys shown at the top of the screen once some already exist -->
    <string name="PasskeysScreen__set_up_a_passkey_with">Поставете клуч за пристап со биометриските податоци на вашиот уред или со компатибилен безбедносен клуч по FIDO2 стандард.</string>
    <!-- Button that starts creating a passkey once some already exist -->
    <string name="PasskeysScreen__add_a_new_passkey">Додајте нов клуч за пристап</string>
    <!-- Label under a passkey\'s name saying when it was added. The placeholder is a relative time like "today, 11:00 AM" -->
    <string name="PasskeysScreen__added_s">„%1$s“ е додаден/а</string>
    <!-- Accessibility description of the button that opens a passkey\'s menu -->
    <string name="PasskeysScreen__open_passkey_options">Отворете ги опциите за клучеви за пристап</string>
    <!-- Menu option that renames a passkey -->
    <string name="PasskeysScreen__rename">Сменете име</string>
    <!-- Menu option that removes a passkey -->
    <string name="PasskeysScreen__remove">Отстрани</string>

    <!-- TotpCodeEntryScreen -->
    <!-- Title of the screen where the user enters the code from their authenticator app -->
    <string name="TotpCodeEntryScreen__enter_your_code">Внесете го вашиот код</string>
