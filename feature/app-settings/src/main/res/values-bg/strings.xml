    <string name="PasskeysScreen__open_passkey_options">Отваряне на опциите за ключ за достъп</string>
    <!-- Menu option that renames a passkey -->
    <string name="PasskeysScreen__rename">Преименуване</string>
    <!-- Menu option that removes a passkey -->
    <string name="PasskeysScreen__remove">Премахване</string>

