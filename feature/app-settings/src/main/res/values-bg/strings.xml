    <!-- Clickable text that takes the user to a support article -->
    <string name="PasskeysScreen__learn_more">Научете повече</string>
    <!-- Bullet point explaining that a passkey can be given a name -->
    <string name="PasskeysScreen__give_your_passkey_a_friendly_name">Дайте на вашия ключ за достъп запомнящо се име, за да го разпознавате</string>
