    <string name="AccountSettingsFragment__your_signal_login_is_used_to_recover">Votre identifiant Signal vous permet de récupérer et de restaurer votre compte. Conservez ces clés en lieu sûr, dans un gestionnaire de mots de passe fiable.</string>
    <!-- Section header for the two-factor authentication section of account settings -->
    <string name="AccountSettingsFragment__two_factor_authentication">Authentification à deux facteurs</string>
    <!-- Account setting that takes the user to the authenticator app setup flow -->
    <string name="AccountSettingsFragment__authenticator_app">Appli d\'authentification</string>
    <!-- Description of the authenticator app setting when none are configured -->
    <string name="AccountSettingsFragment__one_time_verification_codes">One-time verification codes</string>
