    <!-- Body of the first step of authenticator app setup -->
    <string name="AuthenticatorSetupScreen__install_a_trusted_authenticator_app">तुमच्या डिव्हाईस वर एक विश्वासार्ह ऑथेंटिकेटर ॲप इन्स्टॉल करा.</string>
