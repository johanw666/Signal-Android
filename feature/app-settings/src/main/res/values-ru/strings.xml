    <string name="PasskeysScreen__learn_more">Узнать больше</string>
    <!-- Bullet point explaining that a passkey can be given a name -->
    <string name="PasskeysScreen__give_your_passkey_a_friendly_name">Выберите понятное имя для ключа доступа, чтобы вам было проще узнать его позже</string>
