    <!-- Body of the first step of authenticator app setup -->
    <string name="TotpSetupScreen__install_a_trusted_authenticator_app">अपने डिवाइस में कोई भरोसेमंद ऑथेंटिकेटर ऐप इंस्टॉल करें।</string>
